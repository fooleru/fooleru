# 家具 id → 分档（**纯查询表**，由上面数组派生；`Furniture.gd` / 生成器 / 闸门共用同一份，
#   避免三处各写一份映射而漂移）。
static func furniture_cat(id: String) -> String:
	for f in FURNITURE_TYPES:
		if String(f.get("id", "")) == id:
			return String(f.get("cat", ""))
	return ""

