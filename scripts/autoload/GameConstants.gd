#   K–N = 房内家具（双人床 / 储藏室 / 电脑 / 召唤器装置）。
const BASE_REGION_NAMES := {
	"A": "起始房间",
	"B": "工作室",
	"C": "厨房",
	"D": "医疗室",
	"E": "电力间",
	"F": "通讯室",
	"G": "温室",
	"H": "训练场",
	"I": "研究室",
	"J": "末日之源召唤器",
	"K": "双人床",
	"L": "储藏室",
	"M": "电脑",
	"N": "召唤器装置",
}

# 区域标签字母 -> 区域名。未登记的字母回退为 "区域<字母>"，
#   这样**用户自己往地图里加新标签（如"I"）不会导致解析失败**，只是名字是自动生成的。
# ⚠ 用 "%s" 格式化而不是 `+` 拼接：GDScript 里String + String 虽然可用，
#   但格式化更明确、不依赖操作数类型，避免以后传入非 String 时静默出错。
static func region_name_for(ch: String) -> String:
	if BASE_REGION_NAMES.has(ch):
		return String(BASE_REGION_NAMES[ch])
	return "区域%s" % ch

# ==== R-124：UI 中文字体（**关键缺陷修复**）====
# 【问题】Godot 内置 `ThemeDB.fallback_font`（FontFile）**不含 CJK 字形** ——
#   实测 `has_char('F')=true` 但 `has_char('按')=false` / `has_char('进')=false`。
#   → 全工程 UI 是 `_draw()` + `fallback_font` 手绘，所以**所有中文文本在实机
#     （非 headless）完全不渲染**：底部交互提示「按 F 进入下一层」、箱子提示、
#     背包标题、暂停页… 只有 ASCII（楼层号 F100）能显示。
#   ⚠ 这就是「出发提示改了位置但实机仍然无效」的**真正根因**（与位置无关）。
# 【修法】统一改用 `SystemFont` + 系统中文（微软雅黑优先，回退黑体/宋体/苹方）。
#   ⚠ `SystemFont` 依赖目标机字体，若全都不存在会回退 `sans-serif`（可能仍无 CJK）；
#     正式发布建议改为**内嵌像素中文字体**（art-bible 要求像素字格，见 D-xx）—— 本批先用系统字体止血。
static var _ui_font_cache: Font = null
static func ui_font() -> Font:
	if _ui_font_cache == null:
		var sf := SystemFont.new()
		sf.font_names = PackedStringArray([
			"Microsoft YaHei", "SimHei", "SimSun", "PingFang SC", "Noto Sans CJK SC", "sans-serif"])
		# R-new（2026-10-22）：文字清晰度 —— UI 在 320×180 设计空间按 UI_SCALE=2 放大；
		#   默认字形按 font_size(8) 栅格化成位图后被 ×2 放大 → 发虚（瓦片是矢量所以清楚）。
		#   设 oversampling=UI_SCALE 让字形直接按 2× 栅格化（8→16px），放大后 1:1 → 清晰锐利。
		sf.oversampling = float(UI_SCALE)
		_ui_font_cache = sf
	return _ui_font_cache

