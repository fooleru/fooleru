; R-78：加了 4 行状态 + 1 个按钮后，VBox 内容总高约 164px（已超原先 140px 的容器）→ 容器加高到 168px。
; R-80：再加 2 行备弹，实测内容总高 **194px**，而视口只有 180px → 底部「退出游戏」被挤出屏幕。
;   （这是 R-78 那个坑的复发，所以 R-80 的验证里把"内容必须完整落在视口内"固化成断言。）
;   压缩方案：状态行字号 9→8、separation 3→2、按钮高 20→18、标题 14→13、
;   并把容器改成 0..180 满高（原来上下各留 6px 的留白在满高时已无必要）。
; R-89：状态区两列都变成 5 行（行数对齐，见下面的 StatsBox 注释）→ 状态区高度 +1 行。
;   实测（--verify-loadout2 ③）：整页内容 y = 2..160，**完整落在视口 0..180 内**，余量 20px。
;   所以**不需要**再压字号或行距 —— 这也是"两列"方案在R-80 之后的第二次红利：
;   R-80 单列 6 行时总高 194px 曾把底部按钮挤出屏幕，两列化之后加行已经不痛了。
[node name="Center" type="VBoxContainer" parent="PauseScreen"]
offset_left = 56.0
offset_top = 2.0
offset_right = 264.0
offset_bottom = 178.0
theme_override_constants/separation = 2

[node name="Label" type="Label" parent="PauseScreen/Center"]
text = "已暂停"
theme_override_colors/font_color = Color(0.95, 0.96, 0.99, 1)
theme_override_font_sizes/font_size = 13
horizontal_alignment = 1

; R-78：暂停页显示玩家四项状态（当前 / 上限）。刻意用**文字**而不是 HUD 那套色条 ——
; 暂停是"停下来读信息"的时刻，色条要靠比较，数字是直接可读的。
[node name="StatsBox" type="GridContainer" parent="PauseScreen/Center"]
theme_override_constants/h_separation = 8
theme_override_constants/v_separation = 1
columns = 2

; R-81：GridContainer 是**按子节点顺序先填满一行再换行**，所以下面的声明顺序 =
;   (生命|备弹) → (体力|9×19) → (饥饿|12×70) → (口渴|空)。
;   两列后行数 6→4，纵向宽裕了；反过来容器 128→208px（每列 ~104px），
;   状态行字号 8→9 重新可读，列间 8px 让两列一眼分得开。
; R-89：左列加「负重」、右列加 5.56 / 7.62 → **两列都变成 5 行**（正好对齐，见下）。
;   ⚠ 声明顺序必须按"逐行"排（GridContainer 是行优先填充）：
;     (HpLabel|ReserveTitleLabel) → (StaminaLabel|Reserve9Label) → (HungerLabel|Reserve12Label)
;   → (ThirstLabel|**Reserve556Label**) → (**LoadLabel**|**Reserve762Label**)
;   所以下面三个新节点的**声明位置**看着"跳"（Reserve556Label 在 ThirstLabel 之后、
;   LoadLabel 在 Reserve556Label 之后）—— 这是行优先填充的必然结果，**不是排版错误**。
;   若把 LoadLabel 声明在 ThirstLabel 之前，它会落到第4 行的左格、把「口渴」挤到右格，
;   「备弹」表头就与某个口径同行了（R-81 的 c4 断言会当场变红）。
[node name="HpLabel" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "生命  -- / --"
theme_override_colors/font_color = Color(0.45, 0.92, 0.48, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

[node name="ReserveTitleLabel" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "备弹"
theme_override_colors/font_color = Color(0.62, 0.65, 0.72, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

[node name="StaminaLabel" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "体力  -- / --"
theme_override_colors/font_color = Color(0.50, 0.74, 0.94, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

; R-80：备弹（**每个口径一行**，因为手枪/MP5 共用 9×19、霰弹枪独立 12×70，
;   只显示当前武器口径就看不到另一口径囤了多少）。斜杠右侧是**该口径的携带上限**。
[node name="Reserve9Label" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "9×19  -- / --"
theme_override_colors/font_color = Color(0.78, 0.80, 0.86, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

[node name="HungerLabel" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "饥饿  -- / --"
theme_override_colors/font_color = Color(0.90, 0.66, 0.34, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

[node name="Reserve12Label" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "12×70  -- / --"
theme_override_colors/font_color = Color(0.85, 0.68, 0.45, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

[node name="ThirstLabel" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "口渴  -- / --"
theme_override_colors/font_color = Color(0.45, 0.80, 0.95, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

; R-89：右列第4 行 —— 5.56（**步枪口径**）。⚠ 本作本次**不加步枪**，
;   所以这一行会长期显示 "5.56  0 / 180"（用户拍板「只加显示」）。
;   显示用小数点 `5.56`（行业标准写法），字典键是 `5x56`。
[node name="Reserve556Label" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "5.56  -- / --"
theme_override_colors/font_color = Color(0.72, 0.76, 0.82, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

; R-89：左列第 5 行 —— 负重 / 负重上限。⚠ 与其它四行不同，用 `%.1f`（一位小数）
;   而不是 `%d`：负重是**连续量**且超重判定用的就是这个连续值，整数化会让显示与判定脱节。
[node name="LoadLabel" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "负重  -- / --"
theme_override_colors/font_color = Color(0.60, 0.66, 0.78, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

; R-89：右列第 5 行 —— 7.62（同 5.56，同为步枪口径，本次也用不满；字典键 `7x62`）。
[node name="Reserve762Label" type="Label" parent="PauseScreen/Center/StatsBox"]
text = "7.62  -- / --"
theme_override_colors/font_color = Color(0.80, 0.72, 0.62, 1)
theme_override_font_sizes/font_size = 9
horizontal_alignment = 1
mouse_filter = 2

