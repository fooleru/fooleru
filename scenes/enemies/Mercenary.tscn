[gd_scene load_steps=3 format=3 uid="uid://cp2_merc_0001"]

[ext_resource type="Script" path="res://scenes/enemies/Mercenary.gd" id="1_merc"]

[sub_resource type="RectangleShape2D" id="rect_m"]
size = Vector2(10, 10)

; ==== R-93 敌人互不碰撞（围攻感）====
; collision_mask = 19 = 31 & ~4 & ~8
;   原值 31 = 1(墙) + 2(玩家) + 4(亡灵) + 8(雇佣兵) + 16(家具)  ← 全层通吃
;   去掉 & ~4（僵尸层）→ 佣兵不再被僵尸物理阻挡（推进路径更直接）
;   去掉 & ~8（佣兵自己这层）→ 佣兵之间也不再互相阻挡
;   保留 1(墙) + 2(玩家) + 16(家具) → 仍被墙/箱子挡住、仍会撞到玩家
; ⚠ collision_layer 保持 8 不变：子弹/敌我判定（Bullet.gd `collision_mask = 7 if hostile else 13`）
;   依赖 layer，不依赖本 mask。
[node name="Mercenary" type="CharacterBody2D"]
collision_layer = 8
collision_mask = 51   ; R-155: 19(墙1+玩家2+家具16) +32 = b类家具(防弹玻璃)也挡敌人
script = ExtResource("1_merc")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
	shape = SubResource("rect_m")

[node name="Sprite" type="Polygon2D" parent="."]
	color = Color(0.55, 0.62, 0.25, 1)
	polygon = PackedVector2Array(-5, -5, 5, -5, 5, 5, -5, 5)

[node name="Muzzle" type="Marker2D" parent="."]
	position = Vector2(8, 0)
