[gd_scene load_steps=3 format=3 uid="uid://cp1_splitter_0001"]

[ext_resource type="Script" path="res://scenes/enemies/Splitter.gd" id="1_splitter"]

[sub_resource type="RectangleShape2D" id="rect_s"]
size = Vector2(24, 24)

; ==== R-149 · Boss 敌人「分裂怪」====
; 【与 Zombie.tscn 的差异 —— 只有三处】
;   ① node name -> Splitter；script -> Splitter.gd（继承 Zombie.gd，只改数值+生成器+不攻击）
;   ② 碰撞盒 12×12 -> **24×24**：用户逐字「体型比普通僵尸大4倍（2x2个普通僵尸）」
;      —— 碰撞盒边长 24 = 2 × 12（普通僵尸碰撞盒）。
;   ③ Sprite polygon 12×12 色块 -> 24×24（顶点 ±12），颜色改成**深紫**
;      Color(0.55, 0.2, 0.65, 1)：
;      —— 必须与僵尸红 Color(0.85,0.2,0.2)、Brute 橙褐 Color(0.9,0.35,0.1)、
;      佣兵黄绿**四向可分**：玩家在 320×180 内分辨率下要一瞬间分辨
;      "普通僵尸 / 快攻型 / 远程佣兵 / Boss"，深紫是第四类色相、与前三者距离最远。
;      ⚠ **这只是占位色**：接入后本行的 Sprite 会被 `Sprite2D.new()`（名 `EnemyArt`）
;      的程序化精灵整体替换（Zombie.gd `_refresh_art()` 既有模式，.tscn 不动），
;      且 `Splitter.gd` 会把 EnemyArt `scale = Vector2(2,2)` 表达「大 4 倍」。
;      Boss 专用图是**后续美术批**，本批复用 zombie.png 靠 scale 2× 表达「大」。
;
; 【刻意不变的】
;   · collision_layer = 4（亡灵层）：子弹与敌我判定依赖 layer，不依赖 mask
;   · collision_mask = 19：与僵尸同为"被墙/箱子/玩家挡住，但不与其它敌人互撞"（R-93 围攻感）
;   · 节点名 `Sprite`：父类 `@onready var sprite: Polygon2D = $Sprite` 依赖它
;   · 节点名 `Muzzle`：父类 `_face()` / 枪口相关逻辑依赖它（保持结构一致无副作用）
[node name="Splitter" type="CharacterBody2D"]
collision_layer = 4
collision_mask = 19
script = ExtResource("1_splitter")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
shape = SubResource("rect_s")

[node name="Sprite" type="Polygon2D" parent="."]
color = Color(0.55, 0.2, 0.65, 1)
polygon = PackedVector2Array(-12, -12, 12, -12, 12, 12, -12, 12)

[node name="Muzzle" type="Marker2D" parent="."]
position = Vector2(8, 0)
